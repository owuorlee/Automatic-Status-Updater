# ── Phase 1 proof config ─────────────────────────────────────────────
# Copy to `.env` and adjust. All values are optional; sensible defaults apply.

# Where Baileys stores auth state for this proof (Phase 1 only — replaced by a
# DB-backed, encrypted adapter in Phase 3). This folder is a SECRET.
AUTH_DIR=.auth/phase1

# Baileys internal log level: silent | error | warn | info | debug | trace
BAILEYS_LOG_LEVEL=silent

# ── What to post ─────────────────────────────────────────────────────
# If IMAGE_PATH is set, an IMAGE status is posted; otherwise a TEXT status.
# IMAGE_PATH=C:\path\to\a\product-photo.jpg
CAPTION=Phase 1 proof ✅ automated status post
STATUS_TEXT=Phase 1 proof ✅ (text status)
BG_COLOR=#128C7E

# ── Who sees the status (audience) ───────────────────────────────────
# WhatsApp Status only reaches saved contacts. Leave blank to auto-use the
# account's synced contacts (falling back to your own number). Or hard-set a
# comma-separated list of numbers in full international format, no plus sign:
# STATUS_AUDIENCE=2547XXXXXXXX,2547YYYYYYYY
STATUS_AUDIENCE=

# ── Datastore (Phase 3+) ─────────────────────────────────────────────
# Postgres connection string used by Prisma. Not needed for Phase 1, the risk
# self-test, or the media self-test. `prisma generate`/`validate` don't require
# a live DB; running migrations does.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wa_status?schema=public
