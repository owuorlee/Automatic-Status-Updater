{
  "name": "wa-status-poster",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Automated WhatsApp Status poster for SMBs (Baileys). Phase 1 = risky-primitive proof.",
  "scripts": {
    "phase1": "tsx src/phase1/link-and-post.ts",
    "typecheck": "tsc --noEmit",
    "test:risk": "tsx src/risk/selftest.ts",
    "test:media": "tsx src/media/selftest.ts",
    "test:caption": "tsx src/caption/selftest.ts",
    "test:auth": "tsx src/wa/auth/selftest.ts",
    "test:transport": "tsx src/wa/transport/selftest.ts",
    "test:session": "tsx src/wa/session/selftest.ts",
    "test": "npm run typecheck && npm run test:risk && npm run test:media && npm run test:caption && npm run test:auth && npm run test:transport && npm run test:session",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "prisma:validate": "prisma validate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@prisma/client": "^7.9.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "https-proxy-agent": "^9.1.0",
    "pino": "^9.5.0",
    "prisma": "^7.9.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
