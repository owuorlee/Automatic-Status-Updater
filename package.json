{
  "name": "wa-status-poster",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Automated WhatsApp Status poster for SMBs (Baileys). Phase 1 = risky-primitive proof.",
  "scripts": {
    "phase1": "tsx src/phase1/link-and-post.ts",
    "typecheck": "tsc --noEmit",
    "test:risk": "tsx src/risk/selftest.ts",
    "test:media": "tsx src/media/selftest.ts",
    "test": "npm run typecheck && npm run test:risk && npm run test:media",
    "prisma:validate": "prisma validate",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "pino": "^9.5.0",
    "prisma": "^7.9.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
